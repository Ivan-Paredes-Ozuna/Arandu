# Supabase → Project Settings → Database
# Connection string (URI) mode: Transaction o Session
# JDBC tipico:
# jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_DB_PASSWORD
JWT_SECRET=cambia-esta-clave-larga-de-al-menos-32-caracteres

# Orígenes del frontend (local + Vercel), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
